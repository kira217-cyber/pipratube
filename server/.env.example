PORT=5100
MONGO_URI=mongodb://127.0.0.1:27017/pipratv_v2
JWT_SECRET=change_me
ADMIN_JWT_SECRET=change_me_too

# Public address of this API — images in uploads/ are served from here.
# Production: https://api.pipratube.com
PUBLIC_URL=http://localhost:5100
# The viewer site, used in link previews (Facebook, WhatsApp...)
SITE_URL=https://pipratube.com


# First admin, created by `npm run seed:admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# Video storage: "storage" (Bunny Storage, mp4) or "stream" (Bunny Stream, HLS)
VIDEO_PROVIDER=storage
BUNNY_STORAGE_ZONE=your-zone
BUNNY_STORAGE_FOLDER=PipraV2
BUNNY_STORAGE_HOST=sg.storage.bunnycdn.com
BUNNY_CDN_HOSTNAME=your-zone.b-cdn.net
BUNNY_STORAGE_ACCESS_KEY=your_storage_access_key
BUNNY_MAX_VIDEO_SIZE_MB=2048

# Video uploads: any format, converted to MP4 (H.264/AAC) with the bundled ffmpeg.
MAX_UPLOAD_GB=50
# Biggest picture accepted (any format; saved as WebP)
MAX_IMAGE_MB=100
# How many videos are converted at the same time, and how hard ffmpeg works
# (ultrafast…veryslow — slower = smaller files, more CPU).
PROCESSING_CONCURRENCY=1
FFMPEG_PRESET=veryfast
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
